{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 52,
  "control-center-margin-right": 12,
  "control-center-width": 400,
  "control-center-preferred-output": "DP-2",
  "notification-window-preferred-output": "DP-2",
  "notification-window-width": 380,
  "notification-icon-size": 44,
  "notification-body-image-height": 120,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "keyboard-shortcuts": true,
  "notification-grouping": false,
  "image-visibility": "when-available",
  "transition-time": 220,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
  "text-empty": "ALL CLEAR",
  "widgets": ["title", "dnd", "notifications"],
  "widget-config": {
    "title": { "text": "NOTIFICATIONS", "clear-all-button": true, "button-text": "CLEAR" },
    "dnd": { "text": "Silent" },
    "notifications": { "vexpand": true }
  }
}
