/* Session menu — full-screen dim, five frosted tiles
   Colours + fonts: ~/.config/hypr/theme/palette.rasi          */
@import "~/.config/hypr/theme/palette.rasi"

configuration {
  show-icons: false;
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
}
* {
  background-color: transparent; text-color: @fg;
  font: @font-ui;
}
window {
  fullscreen: true;
  background-color: @scrim;
  padding: 0;
}
mainbox {
  children: [ dummy-top, textbox-title, listview, textbox-hint, dummy-bottom ];
  spacing: 28px;
}
dummy-top, dummy-bottom { expand: true; }
textbox-title {
  content: "Session";
  font: @font-display;
  horizontal-align: 0.5;
  expand: false;
  text-color: @fg;
}
listview {
  columns: 5; lines: 1; fixed-columns: true; fixed-height: true;
  spacing: 18px;
  expand: false;
  layout: vertical;
  margin: 0 28%;
  scrollbar: false;
  cycle: true;
}
element {
  orientation: vertical;
  padding: 26px 0 22px 0;
  border: 1px; border-color: @line; border-radius: 20px;
  background-color: @glass;
  cursor: pointer;
}
element-text {
  horizontal-align: 0.5; vertical-align: 0.5;
  text-color: inherit;
  cursor: inherit;
}
element selected.normal { background-color: @accent; text-color: @on-accent; border-color: transparent; }
element selected.urgent { background-color: @alert; text-color: @on-accent; border-color: @alert; }
element normal.urgent   { text-color: @fg; }
textbox-hint {
  content: "P  Power off   ·   R  Restart   ·   S  Sleep   ·   L  Lock   ·   E  Log out   ·   Esc  Cancel";
  font: @font-ui-sm;
  text-color: @dim;
  horizontal-align: 0.5;
  expand: false;
}
