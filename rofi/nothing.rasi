/* Launcher — Spotlight-like smoky glass card, soft rows
   Colours + fonts: ~/.config/hypr/theme/palette.rasi                    */
@import "~/.config/hypr/theme/palette.rasi"

configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  display-drun: "Apps";
  display-run: "Run";
  display-window: "Windows";
  drun-display-format: "{name}";
  sort: true;
  sorting-method: "fzf";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
  kb-cancel: "Escape,Super+d,Super+r";
}

* {
  background-color: transparent;
  text-color: @fg;
  font: @font-ui;
}

window {
  width: 600px;
  border: 1px; border-color: @line; border-radius: 22px;
  background-color: @glass;
  padding: 16px;
  location: north;
  y-offset: 120px;
}
mainbox  { spacing: 12px; children: [ inputbar, mode-switcher, listview ]; }

inputbar {
  background-color: @card;
  border-radius: 14px;
  padding: 12px 18px;
  spacing: 12px;
  children: [ textbox-icon, entry ];
}
textbox-icon  { content: "⌕"; text-color: @dim; expand: false; vertical-align: 0.5; }
entry {
  placeholder: "Search";
  placeholder-color: @mute;
  cursor: text;
}

mode-switcher { spacing: 8px; enabled: false; }
button {
  padding: 6px 14px;
  border-radius: 10px;
  background-color: @card;
  text-color: @dim;
  font: @font-ui-sm;
}
button selected { background-color: @accent; text-color: @on-accent; }

listview {
  lines: 7; columns: 1;
  spacing: 2px;
  scrollbar: false;
  fixed-height: true;
  cycle: true;
}
element {
  padding: 9px 14px;
  border-radius: 12px;
  spacing: 14px;
  cursor: pointer;
}
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal { background-color: @card2; text-color: @fg; }
element-icon { size: 24px; cursor: inherit; }
element-text { text-color: inherit; vertical-align: 0.5; cursor: inherit; }

message  { padding: 10px 16px; border-radius: 14px; background-color: @card; }
textbox  { text-color: @dim; }
