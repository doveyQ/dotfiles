/* Launcher — Spotlight: one frosted glass panel, large search field, compact rows
   Colours + fonts: ~/.config/hypr/theme/palette.rasi (light / dark)             */
@import "~/.config/hypr/theme/palette.rasi"

configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  display-drun: "Apps";
  display-run: "Run";
  display-window: "Windows";
  drun-display-format: "{name}";
  sort: true;
  sorting-method: "fzf";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
  kb-cancel: "Escape,Super+d,Super+r";
}

* {
  background-color: transparent;
  text-color: @fg;
  font: @font-ui;
}

window {
  width: 680px;
  border: 1px; border-color: @line; border-radius: 16px;
  background-color: @glass;
  padding: 8px;
  location: north;
  y-offset: 180px;
}
mainbox  { spacing: 6px; children: [ inputbar, mode-switcher, listview ]; }

inputbar {
  padding: 10px 12px;
  spacing: 12px;
  border: 0 0 1px 0; border-color: @line;
  children: [ textbox-icon, entry ];
}
textbox-icon  { content: "⌕"; font: @font-search; text-color: @dim; expand: false; vertical-align: 0.5; }
entry {
  placeholder: "Spotlight Search";
  placeholder-color: @mute;
  font: @font-search;
  cursor: text;
  vertical-align: 0.5;
}

mode-switcher { spacing: 8px; enabled: false; }
button {
  padding: 5px 12px;
  border-radius: 8px;
  background-color: @card;
  text-color: @dim;
  font: @font-ui-sm;
}
button selected { background-color: @accent; text-color: @on-accent; }

listview {
  lines: 8; columns: 1;
  spacing: 1px;
  scrollbar: false;
  fixed-height: false;
  dynamic: true;
  cycle: true;
  padding: 4px 0 0 0;
}
element {
  padding: 7px 10px;
  border-radius: 8px;
  spacing: 12px;
  cursor: pointer;
}
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal { background-color: @accent; text-color: @on-accent; }
element-icon { size: 26px; cursor: inherit; }
element-text { text-color: inherit; vertical-align: 0.5; cursor: inherit; }

message  { padding: 8px 12px; border-radius: 10px; background-color: @card; }
textbox  { text-color: @dim; }
