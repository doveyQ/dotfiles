/* Nothing OS launcher — black glass card, pill rows, dot-matrix search */
configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  display-drun: "APPS";
  display-run: "RUN";
  display-window: "WINDOWS";
  drun-display-format: "{name}";
  sort: true;
  sorting-method: "fzf";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
  kb-cancel: "Escape,Super+d,Super+r";
}

* {
  bg: #0a0a0af2; card: #1e1e1ecc; line: #ffffff14;
  fg: #ffffff; dim: #8a8a8a; red: #d71921;
  background-color: transparent;
  text-color: @fg;
  font: "Inter 12";
}

window {
  width: 580px;
  border: 1px; border-color: @line; border-radius: 32px;
  background-color: @bg;
  padding: 20px;
  location: north;
  y-offset: 120px;
}
mainbox  { spacing: 14px; children: [ inputbar, mode-switcher, listview ]; }

inputbar {
  background-color: @card;
  border-radius: 999px;
  padding: 13px 20px;
  spacing: 12px;
  children: [ textbox-dot, entry ];
}
textbox-dot   { content: "●"; text-color: @red; expand: false; vertical-align: 0.5; }
entry {
  placeholder: "SEARCH";
  placeholder-color: @dim;
  font: "Ndot 55 13";
  cursor: text;
}

mode-switcher { spacing: 8px; enabled: false; }
button {
  padding: 6px 14px;
  border-radius: 999px;
  background-color: @card;
  text-color: @dim;
  font: "Ndot 55 10";
}
button selected { background-color: @fg; text-color: #000000; }

listview {
  lines: 7; columns: 1;
  spacing: 4px;
  scrollbar: false;
  fixed-height: true;
  cycle: true;
}
element {
  padding: 10px 16px;
  border-radius: 999px;
  spacing: 14px;
  cursor: pointer;
}
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal { background-color: @fg; text-color: #000000; }
element-icon { size: 24px; cursor: inherit; }
element-text { text-color: inherit; vertical-align: 0.5; cursor: inherit; }

message  { padding: 10px 16px; border-radius: 20px; background-color: @card; }
textbox  { text-color: @dim; }
