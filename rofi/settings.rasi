/* Pickers (night mode, keybindings …) — the Spotlight look, two columns */
@import "nothing.rasi"
window   { width: 640px; }
listview { columns: 2; lines: 8; spacing: 4px; fixed-height: true; }
element  { padding: 10px 14px; border-radius: 10px; background-color: @card; }
element selected.normal { background-color: @accent; text-color: @on-accent; }
entry    { placeholder: "Search"; }
