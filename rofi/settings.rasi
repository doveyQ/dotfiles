/* Settings hub / pickers — inherits the launcher look, two-column grid */
@import "nothing.rasi"
window   { width: 640px; }
listview { columns: 2; lines: 8; spacing: 6px; fixed-height: true; }
element  { padding: 13px 18px; border-radius: 12px; background-color: @card; }
element selected.normal { background-color: @card2; text-color: @fg; }
entry    { placeholder: "Settings"; }
